{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "outDir": "./dist",
        "skipLibCheck": true,
        "esModuleInterop": true,
        "baseUrl": "./",
        "paths": {
            "src/*": ["./src/*"]
        },
        "typeRoots": [
            "./node_modules/@types",
            "./src/types"
        ],
    },
    "include": [
        "src/**/*",
        "src/types/**/*.d.ts",

    ]
}
